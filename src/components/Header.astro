---
import { Image } from 'astro:assets';
import brandLogo from '../assets/brand-signature.webp';
---

<header class="header js-header">
  <div class="container header__inner">
    <a href="#hero" class="header__logo js-nav-link">
      <Image 
        src={brandLogo} 
        alt="Printt Cores" 
        width={500}
        quality="max"
        class="logo__img"
        loading="eager"
      />
    </a>

    <nav class="header__nav">
      <a href="#servicos" class="nav__link js-nav-link">Serviços</a>
      <a href="#produtos" class="nav__link js-nav-link">Produtos</a>
      <a href="#portfolio" class="nav__link js-nav-link">Portfólio</a>
      <a href="#processo" class="nav__link js-nav-link">Sobre</a>
      <a href="#contato" class="nav__link js-nav-link">Contato</a>
    </nav>

    <div class="header__action">
      <a 
        href="https://wa.me/5500000000000?text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento." 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn--whatsapp" 
        data-magnetic
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.js-header');
    const navLinks = document.querySelectorAll('.js-nav-link');

    // Scroll: add compact state
    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) {
        header?.classList.add('header--scrolled');
      } else {
        header?.classList.remove('header--scrolled');
      }
    });

    // Smooth scroll with header offset
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          e.preventDefault();
          const targetSection = document.querySelector(href);
          if (targetSection) {
            const offset = 90;
            const pos = targetSection.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: pos, behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        }
      });
    });

    // Magnetic buttons
    document.querySelectorAll('[data-magnetic]').forEach((btn: any) => {
      btn.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, { x: x * 0.25, y: y * 0.25, duration: 0.4, ease: 'power2.out' });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)' });
      });
    });

    // Entrance animation
    gsap.from('.header__logo, .header__nav, .header__action', {
      y: -15,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      stagger: 0.1,
      clearProps: 'transform,opacity'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 1.5rem 0;
    transition: padding $duration-normal ease,
                background-color $duration-normal ease,
                backdrop-filter $duration-normal ease;

    &--scrolled {
      padding: 0.6rem 0;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba($color-dark, 0.08);

      .logo__img {
        height: 58px;
      }
    }

    &__inner {
      @include flex-between;
    }

    &__logo {
      display: flex;
      align-items: center;

      .logo__img {
        height: 72px;
        width: auto;
        object-fit: contain;
        transition: height $duration-normal ease, opacity $duration-normal ease;

        @include respond-to(mobile) {
          height: 56px;
        }
      }

      &:hover .logo__img {
        opacity: 0.85;
      }
    }

    &__nav {
      display: flex;
      align-items: center;
      gap: 0.25rem;

      @include respond-to(tablet) {
        display: none;
      }
    }

    &__action {
      @include respond-to(tablet) {
        display: none;
      }
    }
  }

  .nav__link {
    padding: 0.5rem 1rem;
    font-size: $text-small;
    font-weight: $weight-medium;
    color: $color-text-secondary;
    border-radius: $radius-full;
    @include smooth-transition(color);

    &:hover {
      color: $color-text;
    }
  }
</style>
