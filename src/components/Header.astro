---
import { Image } from 'astro:assets';
import brandLogo from '../assets/brand-signature.webp';
import { SITE_CONFIG } from '../config/site';
---

<header class="header js-header">
  <div class="container">
    <div class="header__inner">
      <!-- Logo Orgânico -->
      <a href="#hero" class="header__logo js-nav-link" aria-label="Ir para o início">
        <Image 
          src={brandLogo} 
          alt="Printt Cores" 
          width={500}
          quality="max"
          class="logo__img"
          loading="eager"
        />
      </a>

      <!-- Navegação Orgânica Desktop -->
      <nav class="header__nav">
        <a href="#servicos" class="nav__link js-nav-link">Serviços</a>
        <a href="#produtos" class="nav__link js-nav-link">Produtos</a>
        <a href="#diferenciais" class="nav__link js-nav-link">Diferenciais</a>
        <a href="#portfolio" class="nav__link js-nav-link">Portfólio</a>
        <a href="#contato" class="nav__link js-nav-link">Contato</a>
      </nav>

      <!-- Ações Orgânicas e Botão Hambúrguer Mobile -->
      <div class="header__action">
        <a 
          href={SITE_CONFIG.telLink} 
          class="header__icon-link" 
          title="Ligar para a Printt Cores"
          aria-label="Ligar para (71) 98706-8000"
          data-magnetic
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span class="phone-num">{SITE_CONFIG.contact.phone}</span>
        </a>

        <a 
          href={SITE_CONFIG.whatsappLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="header__whatsapp-link" 
          title="Falar no WhatsApp"
          aria-label="Falar no WhatsApp"
          data-magnetic
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="wa-text">WhatsApp</span>
        </a>

        <!-- Botão Hambúrguer Mobile -->
        <button 
          class="header__hamburger js-hamburger" 
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
        >
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Overlay de Menu Mobile Refatorado -->
  <div class="header__mobile-menu js-mobile-menu" aria-hidden="true">
    <!-- Botão Fechar Dedicado no Canto Superior -->
    <button class="mobile-menu__close js-mobile-close" aria-label="Fechar menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>Fechar</span>
    </button>

    <div class="mobile-menu__inner">
      <!-- Marca no Topo do Menu Mobile -->
      <a href="#hero" class="mobile-menu__logo js-nav-link" aria-label="Ir para o início">
        <Image 
          src={brandLogo} 
          alt="Printt Cores" 
          width={400}
          quality="max"
          class="mobile-logo__img"
        />
      </a>

      <!-- Navegação Mobile Legível e Espaçada -->
      <nav class="mobile-menu__nav">
        <a href="#servicos" class="mobile-menu__link js-nav-link">Serviços</a>
        <a href="#produtos" class="mobile-menu__link js-nav-link">Produtos</a>
        <a href="#diferenciais" class="mobile-menu__link js-nav-link">Diferenciais</a>
        <a href="#portfolio" class="mobile-menu__link js-nav-link">Portfólio</a>
        <a href="#contato" class="mobile-menu__link js-nav-link">Contato</a>
      </nav>

      <!-- Botões de Ação Alinhados em Coluna -->
      <div class="mobile-menu__actions">
        <a href={SITE_CONFIG.telLink} class="mobile-menu__action-btn mobile-menu__action-btn--dialer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Ligar para {SITE_CONFIG.contact.phone}</span>
        </a>

        <a href={SITE_CONFIG.whatsappLink} target="_blank" rel="noopener noreferrer" class="mobile-menu__action-btn mobile-menu__action-btn--whatsapp">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Chamar no WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { gsap } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.js-header');
    const navLinks = document.querySelectorAll('.js-nav-link');
    const hamburger = document.querySelector<HTMLButtonElement>('.js-hamburger');
    const mobileMenu = document.querySelector<HTMLElement>('.js-mobile-menu');
    const closeBtn = document.querySelector<HTMLButtonElement>('.js-mobile-close');

    // Scroll: compact glass animation
    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) {
        header?.classList.add('header--scrolled');
      } else {
        header?.classList.remove('header--scrolled');
      }
    });

    // Toggle Mobile Hamburger Menu
    function toggleMenu() {
      const isOpen = hamburger?.classList.toggle('hamburger--active');
      mobileMenu?.classList.toggle('mobile-menu--active');
      hamburger?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (mobileMenu) {
        mobileMenu.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      }
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    hamburger?.addEventListener('click', toggleMenu);
    closeBtn?.addEventListener('click', toggleMenu);

    // Smooth scroll with header offset
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          e.preventDefault();
          
          if (hamburger?.classList.contains('hamburger--active')) {
            toggleMenu();
          }

          const targetSection = document.querySelector(href);
          if (targetSection) {
            const offset = 90;
            const pos = targetSection.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: pos, behavior: 'smooth' });
          }
        }
      });
    });

    // Entrance animation
    gsap.from('.header__logo, .header__nav, .header__action', {
      y: -15,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      stagger: 0.1,
      clearProps: 'transform,opacity'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .header {
    position: fixed;
    top: 1rem;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 0;
    pointer-events: none;
    transition: transform $duration-normal ease;

    &__inner {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.4rem 1.25rem;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(7, 21, 45, 0.08);
      border-radius: $radius-full;
      box-shadow: 0 8px 25px rgba(7, 21, 45, 0.05);
      transition: background-color $duration-normal ease,
                  box-shadow $duration-normal ease,
                  padding $duration-normal ease;
    }

    &--scrolled &__inner {
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 30px rgba(7, 21, 45, 0.09);
      padding: 0.3rem 1rem;
    }

    &__logo {
      display: flex;
      align-items: center;

      .logo__img {
        height: 86px;
        width: auto;
        object-fit: contain;
        transition: height $duration-normal ease, opacity $duration-normal ease;

        @include respond-to(mobile) {
          height: 64px;
        }
      }

      &:hover .logo__img {
        opacity: 0.85;
      }
    }

    &__nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;

      @include respond-to(tablet) {
        display: none;
      }
    }

    &__action {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    &__icon-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: $weight-medium;
      color: $color-text-secondary;
      padding: 0.35rem 0.65rem;
      border-radius: $radius-full;
      @include smooth-transition(color, background-color);

      .phone-num {
        @include respond-to(tablet) {
          display: none;
        }
      }

      &:hover {
        color: $color-dark;
        background-color: rgba($color-dark, 0.04);
      }
    }

    &__whatsapp-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: $weight-semibold;
      color: $color-whatsapp;
      background: transparent;
      border: 1px solid rgba($color-whatsapp, 0.28);
      padding: 0.35rem 0.8rem;
      border-radius: $radius-full;
      @include smooth-transition(color, background-color, border-color, transform);

      .wa-text {
        @include respond-to(mobile) {
          display: none;
        }
      }

      &:hover {
        background: rgba($color-whatsapp, 0.08);
        border-color: rgba($color-whatsapp, 0.45);
        transform: translateY(-1px);
      }
    }

    &__hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 40px;
      height: 40px;
      padding: 10px 8px;
      background: rgba($color-dark, 0.05);
      border: 1px solid rgba($color-dark, 0.08);
      border-radius: $radius-full;
      cursor: pointer;
      z-index: 1010;
      @include smooth-transition(background-color, border-color);

      @include respond-to(tablet) {
        display: flex;
      }

      .hamburger__line {
        display: block;
        width: 100%;
        height: 2px;
        background-color: $color-dark;
        border-radius: 2px;
        transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
      }

      &.hamburger--active {
        background: rgba($cmyk-magenta, 0.1);
        border-color: rgba($cmyk-magenta, 0.25);

        .hamburger__line {
          background-color: $cmyk-magenta;
        }

        .hamburger__line:nth-child(1) {
          transform: translateY(7px) rotate(45deg);
        }
        .hamburger__line:nth-child(2) {
          opacity: 0;
        }
        .hamburger__line:nth-child(3) {
          transform: translateY(-7px) rotate(-45deg);
        }
      }
    }
  }

  .nav__link {
    font-size: 0.88rem;
    font-weight: $weight-medium;
    color: $color-text-secondary;
    padding: 0.35rem 0.75rem;
    border-radius: $radius-full;
    position: relative;
    @include smooth-transition(color, background-color);

    &:hover {
      color: $color-dark;
      background-color: rgba($color-dark, 0.04);
    }
  }

  /* Overlay de Menu Mobile Refatorado */
  .header__mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    z-index: 1005;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: $space-2xl $space-lg;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;

    &.mobile-menu--active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-menu__close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.9rem;
      font-weight: $weight-semibold;
      color: $color-dark;
      background: rgba($color-dark, 0.06);
      border: 1px solid rgba($color-dark, 0.1);
      padding: 0.5rem 1rem;
      border-radius: $radius-full;
      cursor: pointer;
      @include smooth-transition(background-color, color);

      &:hover {
        background: rgba($cmyk-magenta, 0.1);
        color: $cmyk-magenta;
      }
    }

    .mobile-menu__inner {
      width: 100%;
      max-width: 360px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $space-xl;
      text-align: center;
    }

    .mobile-menu__logo {
      display: inline-block;

      .mobile-logo__img {
        height: 70px;
        width: auto;
        object-fit: contain;
      }
    }

    .mobile-menu__nav {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
    }

    .mobile-menu__link {
      font-size: 1.4rem;
      font-weight: $weight-bold;
      color: $color-dark;
      padding: 0.75rem $space-md;
      border-radius: $radius-md;
      letter-spacing: -0.02em;
      transition: color 0.2s ease, background-color 0.2s ease;

      &:hover {
        color: $cmyk-magenta;
        background: rgba($cmyk-magenta, 0.06);
      }
    }

    .mobile-menu__actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
    }

    .mobile-menu__action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      font-size: 1rem;
      font-weight: $weight-semibold;
      padding: 0.85rem $space-md;
      border-radius: $radius-full;
      width: 100%;
      text-decoration: none;
      @include smooth-transition(background-color, transform, box-shadow);

      &--dialer {
        color: $color-dark;
        background: rgba($color-dark, 0.05);
        border: 1px solid rgba($color-dark, 0.1);

        &:hover {
          background: rgba($color-dark, 0.1);
        }
      }

      &--whatsapp {
        color: #ffffff;
        background: $color-whatsapp;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);

        &:hover {
          background: darken(#25D366, 5%);
          transform: translateY(-2px);
        }
      }
    }
  }
</style>
