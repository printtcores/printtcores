---
const etapas = [
  {
    step: "01",
    title: "Atendimento & Orçamento",
    desc: "Envie sua ideia, projeto ou arquivo via WhatsApp para receber um atendimento ágil e orçamento personalizado.",
  },
  {
    step: "02",
    title: "Análise & Prévia Digital",
    desc: "Nossa equipe confere seu arquivo, ajusta o gabarito de impressão e envia uma prévia para sua aprovação final.",
  },
  {
    step: "03",
    title: "Impressão & Acabamento",
    desc: "Seu material é impresso em alta definição com rigoroso controle de cor CMYK e acabamentos de precisão.",
  },
  {
    step: "04",
    title: "Controle de Qualidade & Entrega",
    desc: "Seu produto é inspecionado, embalado com cuidado e disponibilizado no Apipema Center ou entregue em Salvador.",
  }
];
---

<section id="processo" class="processo">
  <div class="container">
    <div class="processo__header" data-animate>
      <h2 class="section-title">Como funciona o <span class="text-gradient">Nosso Processo</span></h2>
      <p class="section-desc">Do envio da arte à entrega do material impresso com transparência, agilidade e controle técnico.</p>
    </div>

    <div class="processo__steps">
      {etapas.map((item) => (
        <div class="step js-step" data-animate>
          <div class="step__number">{item.step}</div>
          <div class="step__content">
            <h3 class="step__title">{item.title}</h3>
            <p class="step__desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from '../utils/gsap';
  import { animate, stagger } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.processo .section-title, .processo .section-desc', {
      scrollTrigger: { trigger: '.processo', start: 'top 85%' },
      opacity: 0,
      y: 25,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    gsap.from('.js-step', {
      scrollTrigger: { trigger: '.processo__steps', start: 'top 92%' },
      opacity: 0,
      y: 30,
      stagger: 0.12,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    // Anime.js v4 onda sequencial nos números das etapas
    const stepNumbers = document.querySelectorAll('.step__number');
    if (stepNumbers.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(stepNumbers, {
              scale: [1, 1.25, 1],
              color: ['#07152d', '#e5007d', '#07152d'],
              delay: stagger(180, { start: 300 }),
              duration: 750,
              ease: 'inOutQuad'
            });
            observer.disconnect();
          }
        });
      }, { threshold: 0.3 });

      const stepsContainer = document.querySelector('.processo__steps');
      if (stepsContainer) observer.observe(stepsContainer);
    }
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .processo {
    padding: $space-section 0;
    background: $color-bg;

    &__header {
      margin-bottom: $space-xl;
      max-width: 600px;
    }

    &__steps {
      display: flex;
      flex-direction: column;
    }
  }

  .step {
    display: flex;
    gap: $space-lg;
    padding: $space-lg 0;
    border-bottom: 1px solid rgba($color-dark, 0.08);
    @include smooth-transition(all);

    @include respond-to(mobile) {
      gap: $space-md;
    }

    &:first-child {
      border-top: 1px solid rgba($color-dark, 0.08);
    }

    &:hover {
      padding-left: $space-sm;

      .step__number {
        color: $cmyk-magenta;
      }
    }

    &__number {
      font-family: $font-mono;
      font-size: $text-display;
      font-weight: $weight-light;
      line-height: 1;
      color: rgba($color-dark, 0.08);
      min-width: 120px;
      @include smooth-transition(color);

      @include respond-to(mobile) {
        font-size: $text-h1;
        min-width: 60px;
      }
    }

    &__content {
      flex: 1;
      padding-top: $space-sm;
    }

    &__title {
      font-size: $text-h3;
      font-weight: $weight-semibold;
      margin-bottom: $space-xs;
      letter-spacing: -0.02em;
    }

    &__desc {
      @include body-text($text-small);
      max-width: 450px;
    }
  }
</style>
