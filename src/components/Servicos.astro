---
import { Image } from 'astro:assets';
import imgMugs from '../assets/service-mugs.png';
import imgFrames from '../assets/service-frames.png';
import imgGifts from '../assets/service-gifts.png';

const servicos = [
  {
    num: "01",
    title: "Canecas Personalizadas",
    desc: "Canecas de cerâmica e vidro com impressão em alta definição, durabilidade extrema, cores vibrantes e acabamento profissional para brindes ou uso pessoal.",
    image: imgMugs,
    badge: "Populares",
    accent: "#e5007d"
  },
  {
    num: "02",
    title: "Porta Retratos",
    desc: "Porta retratos elegantes e altamente personalizados em diversos tamanhos, materiais e acabamentos finos para emoldurar seus melhores momentos.",
    image: imgFrames,
    badge: "Exclusivo",
    accent: "#00a3e0"
  },
  {
    num: "03",
    title: "Presentes",
    desc: "Kits de presentes sofisticados, caixas sob medida e brindes corporativos totalmente personalizados com o alto padrão de impressão da Printt Cores.",
    image: imgGifts,
    badge: "Especial",
    accent: "#ffd100"
  }
];
---

<section id="servicos" class="servicos">
  <div class="container">
    <div class="servicos__header" data-animate>
      <h2 class="section-title">Serviços em <span class="text-gradient">Destaque</span></h2>
      <p class="section-desc">Soluções personalizadas em impressão e acabamentos finos para transformar suas ideias em projetos memoráveis.</p>
    </div>

    <div class="servicos__grid">
      {servicos.map((item) => (
        <article class="servico-card js-servico-card js-tilt-card" style={`--card-accent: ${item.accent}`}>
          <div class="servico-card__image-wrap">
            <Image 
              src={item.image} 
              alt={item.title} 
              width={600}
              height={420}
              class="servico-card__img"
            />
          </div>

          <div class="servico-card__content">
            <h3 class="servico-card__title">{item.title}</h3>
            <p class="servico-card__desc">{item.desc}</p>
            
            <a href="#contato" class="servico-card__link">
              <span>Solicitar Orçamento</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from '../utils/gsap';
  import { animateCardBounce } from '../utils/animeAnimations';

  document.addEventListener('DOMContentLoaded', () => {
    // Header reveal
    gsap.from('.servicos__header > *', {
      scrollTrigger: { trigger: '.servicos', start: 'top 85%' },
      opacity: 0,
      y: 25,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    // Stagger card entrance
    gsap.from('.js-servico-card', {
      scrollTrigger: { 
        trigger: '.servicos__grid', 
        start: 'top 92%' 
      },
      opacity: 0,
      y: 35,
      stagger: 0.12,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    // Anime.js hover bounce nos cards de serviços
    document.querySelectorAll('.js-servico-card').forEach((card) => {
      card.addEventListener('mouseenter', () => animateCardBounce(card));
    });

    // Interactive 3D Tilt effect on mousemove (desktop fine pointer only)
    if (window.matchMedia('(pointer: fine)').matches) {
      const tiltCards = document.querySelectorAll('.js-tilt-card');
      tiltCards.forEach((card: any) => {
        card.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = (y - centerY) / 20;
          const rotateY = (centerX - x) / 20;

          gsap.to(card, {
            rotateX: rotateX,
            rotateY: rotateY,
            duration: 0.4,
            ease: 'power2.out',
            transformPerspective: 1000
          });
        });

        card.addEventListener('mouseleave', () => {
          gsap.to(card, {
            rotateX: 0,
            rotateY: 0,
            duration: 0.6,
            ease: 'power2.out'
          });
        });
      });
    }
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .servicos {
    padding: $space-section 0;
    background: $color-bg-alt;

    &__header {
      text-align: center;
      max-width: 640px;
      margin: 0 auto $space-xl auto;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: $space-lg;

      @include respond-to(tablet) {
        grid-template-columns: 1fr;
        gap: $space-md;
      }
    }
  }

  .servico-card {
    background: $color-bg;
    border-radius: $radius-lg;
    overflow: hidden;
    border: 1px solid rgba($color-dark, 0.08);
    display: flex;
    flex-direction: column;
    box-shadow: $shadow-sm;
    will-change: transform;
    @include smooth-transition(all);

    &:hover {
      border-color: var(--card-accent);
      box-shadow: 0 16px 40px rgba(7, 21, 45, 0.09);

      .servico-card__img {
        transform: scale(1.08);
      }

      .servico-card__link {
        color: var(--card-accent);

        svg {
          transform: translateX(6px);
        }
      }
    }

    &__image-wrap {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform $duration-slow $ease-out-expo;
    }

    &__content {
      padding: $space-md;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    &__title {
      font-size: $text-h3;
      font-weight: $weight-bold;
      color: $color-text;
      margin-bottom: $space-xs;
      letter-spacing: -0.02em;
    }

    &__desc {
      @include body-text($text-small);
      line-height: 1.6;
      margin-bottom: $space-md;
      flex: 1;
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: $text-small;
      font-weight: $weight-bold;
      color: $color-text;
      margin-top: auto;
      @include smooth-transition(color);

      svg {
        transition: transform $duration-normal $ease-out-expo;
      }
    }
  }
</style>
