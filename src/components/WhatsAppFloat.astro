<a 
  href="https://wa.me/5500000000000?text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento." 
  target="_blank" 
  rel="noopener noreferrer" 
  class="whatsapp-float js-whatsapp-float"
  aria-label="Falar no WhatsApp"
>
  <div class="whatsapp-float__pulse"></div>
  <svg class="whatsapp-float__icon" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="whatsapp-float__tooltip">Falar no WhatsApp</span>
</a>

<script>
  import { gsap } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.js-whatsapp-float', {
      scale: 0,
      opacity: 0,
      duration: 0.8,
      delay: 1.2,
      ease: 'back.out(1.7)',
      clearProps: 'all'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: $gradient-whatsapp;
    color: #ffffff;
    @include flex-center;
    z-index: 1000;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    @include smooth-transition(all);
    cursor: pointer;

    @include respond-to(mobile) {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 52px;
      height: 52px;

      svg {
        width: 24px;
        height: 24px;
      }
    }

    &:hover {
      transform: scale(1.1);
      box-shadow: 0 12px 32px rgba(37, 211, 102, 0.6);

      .whatsapp-float__tooltip {
        opacity: 1;
        transform: translateY(0);
        visibility: visible;
      }
    }

    &__pulse {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid $color-whatsapp;
      opacity: 0.7;
      animation: whatsappPulse 2s infinite ease-out;
      pointer-events: none;
    }

    &__tooltip {
      position: absolute;
      right: 70px;
      white-space: nowrap;
      background: $color-dark;
      color: #ffffff;
      padding: 0.4rem 0.9rem;
      border-radius: $radius-sm;
      font-size: $text-xs;
      font-weight: $weight-semibold;
      box-shadow: $shadow-md;
      opacity: 0;
      visibility: hidden;
      transform: translateY(4px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
      pointer-events: none;

      &::after {
        content: '';
        position: absolute;
        right: -5px;
        top: 50%;
        transform: translateY(-50%);
        border-width: 5px 0 5px 5px;
        border-style: solid;
        border-color: transparent transparent transparent $color-dark;
      }

      @include respond-to(mobile) {
        display: none;
      }
    }
  }

  @keyframes whatsappPulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }
</style>
