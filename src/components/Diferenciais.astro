---
const diferenciais = [
  {
    num: "01",
    title: "Fidelidade de Cores (CMYK)",
    desc: "Rigoroso controle técnico de cor para garantir que o resultado impresso seja idêntico à sua arte digital.",
  },
  {
    num: "02",
    title: "Acabamentos Especiais",
    desc: "Laminação fosca/brilho, verniz localizado, corte de precisão e materiais nobres para valorizar cada detalhe.",
  },
  {
    num: "03",
    title: "Prazos Rápidos & Pontualidade",
    desc: "Agilidade no processo de pré-impressão e produção com entrega pontual para você ou sua empresa em Salvador.",
  },
  {
    num: "04",
    title: "Atendimento Consultivo",
    desc: "Suporte especializado via WhatsApp para orientar na escolha dos melhores papéis, gramaturas e materiais.",
  }
];
---

<section id="diferenciais" class="diferenciais">
  <div class="container">
    <div class="diferenciais__layout">
      <div class="diferenciais__left" data-animate>
        <h2 class="section-title">Diferenciais que valorizam <span class="text-gradient">sua marca</span></h2>
        <p class="section-desc">Combinamos tecnologia digital de alta definição, papéis nobres e atendimento dedicado no Apipema Center em Salvador.</p>
      </div>

      <div class="diferenciais__right">
        {diferenciais.map((item) => (
          <div class="dif-item js-dif-item" data-animate>
            <span class="dif-item__num">{item.num}</span>
            <div class="dif-item__content">
              <h3 class="dif-item__title">{item.title}</h3>
              <p class="dif-item__desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Left side
    gsap.from('.diferenciais__left > *', {
      scrollTrigger: { trigger: '.diferenciais', start: 'top 85%' },
      opacity: 0,
      y: 25,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    // Right items stagger
    gsap.from('.js-dif-item', {
      scrollTrigger: { trigger: '.diferenciais__right', start: 'top 92%' },
      opacity: 0,
      y: 30,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .diferenciais {
    padding: $space-section 0;
    background: $color-bg;

    &__layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: $space-xl;
      align-items: start;

      @include respond-to(tablet) {
        grid-template-columns: 1fr;
        gap: $space-lg;
      }
    }

    &__left {
      position: sticky;
      top: 120px;

      @include respond-to(tablet) {
        position: static;
      }
    }

    &__right {
      display: flex;
      flex-direction: column;
    }
  }

  .dif-item {
    display: flex;
    gap: $space-md;
    padding: $space-lg 0;
    border-bottom: 1px solid rgba($color-dark, 0.08);
    @include smooth-transition(all);

    &:first-child {
      border-top: 1px solid rgba($color-dark, 0.08);
    }

    &:hover {
      padding-left: $space-sm;

      .dif-item__num {
        color: $cmyk-magenta;
      }
    }

    &__num {
      font-family: $font-mono;
      font-size: $text-h2;
      font-weight: $weight-light;
      color: $color-text-muted;
      line-height: 1;
      min-width: 60px;
      @include smooth-transition(color);
    }

    &__content {
      flex: 1;
    }

    &__title {
      font-size: $text-h3;
      font-weight: $weight-semibold;
      margin-bottom: $space-xs;
      letter-spacing: -0.02em;
    }

    &__desc {
      @include body-text($text-small);
      max-width: 400px;
    }
  }
</style>
