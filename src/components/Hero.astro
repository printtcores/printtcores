<section id="hero" class="hero">
  <div class="container hero__container">
    <div class="hero__content">
      <h1 class="hero__title js-split-title">
        Lorem ipsum<br />
        dolor sit <em>amet</em>
      </h1>

      <p class="hero__desc js-hero-fade">
        Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.
      </p>

      <div class="hero__cta js-hero-fade">
        <a 
          href="https://wa.me/5500000000000?text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento." 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn--whatsapp" 
          data-magnetic
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Falar no WhatsApp</span>
        </a>

        <a href="#servicos" class="btn btn--outline" data-magnetic>
          <span>Ver Serviços</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero__line"></div>
</section>

<script>
  import { gsap, splitTextFallback } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Title character reveal
    const titleEl = document.querySelector<HTMLElement>('.js-split-title');
    if (titleEl) {
      const { chars } = splitTextFallback(titleEl);
      gsap.from(chars, {
        opacity: 0,
        y: 35,
        stagger: 0.015,
        duration: 0.9,
        ease: 'power3.out',
        delay: 0.2,
        clearProps: 'all'
      });
    }

    // Fade-in elements (desc, buttons)
    gsap.from('.js-hero-fade', {
      opacity: 0,
      y: 25,
      stagger: 0.12,
      duration: 0.8,
      ease: 'power3.out',
      delay: 0.5,
      clearProps: 'all'
    });

    // Magnetic on CTA (only on fine pointer devices)
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('[data-magnetic]').forEach((btn: any) => {
        btn.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          gsap.to(btn, { x: x * 0.25, y: y * 0.25, duration: 0.4, ease: 'power2.out' });
        });
        btn.addEventListener('mouseleave', () => {
          gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)' });
        });
      });
    }
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 8rem;
    padding-bottom: $space-2xl;
    background: $color-bg;

    &__container {
      position: relative;
      z-index: 2;
    }

    &__content {
      max-width: 800px;
    }

    &__title {
      font-size: $text-display;
      font-weight: $weight-black;
      line-height: 0.95;
      letter-spacing: -0.04em;
      color: $color-text;
      margin-bottom: $space-md;

      em {
        font-style: italic;
        @include gradient-text(linear-gradient(135deg, $cmyk-magenta 0%, $cmyk-orange 100%));
      }
    }

    &__desc {
      @include body-text(1.15rem);
      max-width: 520px;
      margin-bottom: $space-lg;
    }

    &__cta {
      display: flex;
      gap: $space-sm;
    }

    &__line {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: rgba($color-dark, 0.08);
    }
  }
</style>
