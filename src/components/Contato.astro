---
import { SITE_CONFIG } from '../config/site';
---

<section id="contato" class="contato">
  <div class="container">
    <div class="contato__header" data-animate>
      <h2 class="section-title">Entre em <span class="text-gradient">Contato</span></h2>
      <p class="section-desc">Estamos prontos para atender você e transformar seus projetos gráficos em realidade. Fale conosco diretamente pelo WhatsApp ou visite nossa gráfica.</p>
    </div>

    <div class="contato__grid">
      <!-- WhatsApp Direct Card -->
      <div class="contato-card contato-card--highlight js-contato-card">
        <div class="contato-card__icon whatsapp-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <h3 class="contato-card__title">Atendimento Rápido</h3>
        <p class="contato-card__desc">Solicite seu orçamento instantâneo ou tire dúvidas via WhatsApp.</p>
        <a 
          href={SITE_CONFIG.whatsappLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn--whatsapp" 
          aria-label="Iniciar atendimento rápido no WhatsApp"
          data-magnetic
        >
          <span>Chamar no WhatsApp</span>
        </a>
      </div>

      <!-- Telefone & Email -->
      <div class="contato-card js-contato-card">
        <div class="contato-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="contato-card__title">Telefone & E-mail</h3>
        <p class="contato-card__value">
          <a href={SITE_CONFIG.telLink}>{SITE_CONFIG.contact.phone}</a>
        </p>
        <p class="contato-card__value">
          <a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a>
        </p>
      </div>

      <!-- Endereço -->
      <a 
        href={SITE_CONFIG.address.mapsUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="contato-card js-contato-card"
        aria-label="Ver localização da Printt Cores no Google Maps"
      >
        <div class="contato-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h3 class="contato-card__title">Nosso Estúdio</h3>
        <p class="contato-card__value">{SITE_CONFIG.address.shopping}</p>
        <p class="contato-card__desc">
          {SITE_CONFIG.address.street}<br />
          {SITE_CONFIG.address.bairro}, {SITE_CONFIG.address.city} - {SITE_CONFIG.address.state}<br />
          <strong>CEP {SITE_CONFIG.address.cep}</strong>
        </p>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.contato__header > *', {
      scrollTrigger: { trigger: '.contato', start: 'top 85%' },
      opacity: 0,
      y: 25,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    gsap.from('.js-contato-card', {
      scrollTrigger: { trigger: '.contato__grid', start: 'top 92%' },
      opacity: 0,
      y: 30,
      stagger: 0.12,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .contato {
    padding: $space-section 0;
    background: $color-bg;

    &__header {
      text-align: center;
      max-width: 600px;
      margin: 0 auto $space-xl auto;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: $space-lg;

      @include respond-to(tablet) {
        grid-template-columns: 1fr;
        gap: $space-md;
      }
    }
  }

  .contato-card {
    background: $color-bg-alt;
    border-radius: $radius-lg;
    padding: $space-lg $space-md;
    border: 1px solid rgba($color-dark, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    @include smooth-transition(all);

    &--highlight {
      background: $color-bg;
      border-color: rgba($color-whatsapp, 0.3);
      box-shadow: 0 10px 30px rgba(37, 211, 102, 0.1);
    }

    &:hover {
      transform: translateY(-4px);
      box-shadow: $shadow-lg;
    }

    &__icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba($color-dark, 0.04);
      color: $color-dark;
      @include flex-center;
      margin-bottom: $space-md;

      &.whatsapp-icon {
        background: rgba($color-whatsapp, 0.1);
        color: $color-whatsapp;
      }
    }

    &__title {
      font-size: $text-h3;
      font-weight: $weight-bold;
      color: $color-text;
      margin-bottom: $space-xs;
    }

    &__value {
      font-size: 1.05rem;
      font-weight: $weight-semibold;
      color: $color-text;
      margin-bottom: 0.25rem;
    }

    &__desc {
      @include body-text($text-small);
      margin-bottom: $space-md;
    }

    .btn--whatsapp {
      margin-top: auto;
    }
  }
</style>
