---
import { Image } from 'astro:assets';
import prodPackaging from '../assets/prod-packaging.png';
import prodCards from '../assets/prod-cards.png';
import prodBanner from '../assets/prod-banner.png';
import heroComp from '../assets/hero-composition.png';

const products = [
  { title: "Lorem Ipsum Dolor Sit", image: prodPackaging, span: "large" },
  { title: "Sed Ut Perspiciatis Unde", image: prodCards, span: "small" },
  { title: "At Vero Eos Et Accusamus", image: prodBanner, span: "small" },
  { title: "Excepteur Sint Occaecat", image: heroComp, span: "large" },
];
---

<section id="produtos" class="produtos">
  <div class="container">
    <div class="produtos__header" data-animate>
      <h2 class="section-title">Consectetur <span class="text-gradient">adipiscing</span></h2>
      <p class="section-desc">Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
    </div>

    <div class="produtos__grid">
      {products.map((item) => (
        <article class={`produto-item produto-item--${item.span} js-produto-item`}>
          <div class="produto-item__image">
            <Image 
              src={item.image} 
              alt={item.title} 
              width={800}
              height={600}
              class="produto-item__img"
            />
          </div>
          <div class="produto-item__overlay">
            <h3 class="produto-item__title">{item.title}</h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.produtos .section-title, .produtos .section-desc', {
      scrollTrigger: { trigger: '.produtos', start: 'top 85%' },
      opacity: 0,
      y: 25,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });

    gsap.from('.js-produto-item', {
      scrollTrigger: { trigger: '.produtos__grid', start: 'top 92%' },
      opacity: 0,
      y: 35,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all'
    });
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as *;
  @use '../styles/abstracts/mixins' as *;

  .produtos {
    padding: $space-section 0;
    background: $color-bg-alt;

    &__header {
      margin-bottom: $space-xl;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: $space-md;

      @include respond-to(mobile) {
        grid-template-columns: 1fr;
      }
    }
  }

  .produto-item {
    position: relative;
    border-radius: $radius-lg;
    overflow: hidden;
    cursor: pointer;

    &--large {
      grid-column: span 2;
      .produto-item__image { height: 480px; }

      @include respond-to(mobile) {
        grid-column: span 1;
        .produto-item__image { height: 280px; }
      }
    }

    &--small {
      .produto-item__image { height: 360px; }

      @include respond-to(mobile) {
        .produto-item__image { height: 240px; }
      }
    }

    &__image {
      width: 100%;
      overflow: hidden;
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform $duration-slow $ease-out-expo;
    }

    &__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba($color-dark, 0.7) 0%, transparent 50%);
      display: flex;
      align-items: flex-end;
      padding: $space-md;
      opacity: 0;
      @include smooth-transition(opacity);
    }

    &__title {
      font-size: $text-h3;
      font-weight: $weight-semibold;
      color: #fff;
      letter-spacing: -0.02em;
    }

    &:hover {
      .produto-item__img {
        transform: scale(1.05);
      }

      .produto-item__overlay {
        opacity: 1;
      }
    }
  }
</style>
